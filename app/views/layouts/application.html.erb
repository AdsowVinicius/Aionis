<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Aionis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Aionis">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Ícones pelo pipeline (URL com digest): trocar a arte invalida o cache
        sozinha. Em /public elas ficavam presas 1 ano no CDN. %>
    <link rel="icon" href="<%= asset_path("icon.svg") %>" type="image/svg+xml">
    <%# O "A" é navy: em aba escura sumiria. Variante branca no dark mode. %>
    <link rel="icon" href="<%= asset_path("icon-dark.svg") %>" type="image/svg+xml" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="<%= asset_path("icon.png") %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path("icon.png") %>">
    <meta name="theme-color" content="#0E1B2C">
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 antialiased">
    <%= render "layouts/flash" %>
    <%= yield %>
  </body>
</html>
